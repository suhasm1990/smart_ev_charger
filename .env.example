# NetZero Energy API
NETZERO_SITE_ID=
NETZERO_API_TOKEN=

# ChargePoint
CHARGEPOINT_USERNAME=
CHARGEPOINT_COULOMB_TOKEN=
CHARGEPOINT_DEVICE_ID=

# Pushover notifications (optional)
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=

# Google Sheets Integration (Requires service_account.json)
GOOGLE_SHEET_URL=

# Timezone and Schedule
TZ=America/Los_Angeles
DAILY_RESET_TIME=00:00
DAILY_AGENT_TIME=07:00

# Utility Rate Provider (MID, PGE, or CUSTOM)
UTILITY_PROVIDER=MID
UTILITY_FIXED_MONTHLY_FEE=32.00
UTILITY_VOLUMETRIC_ADDER=0.0151
UTILITY_TAX_MULTIPLIER=1.065
UTILITY_SOLAR_EXPORT_CREDIT_RATE=0.076


# Thresholds (Optional: remove comment to override defaults)
# BATTERY_START_PCT=40
# BATTERY_STOP_PCT=25
# MIN_CHARGE_MINUTES=15
# NIGHT_BLACKOUT_START_HOUR=16
# NIGHT_BLACKOUT_END_HOUR=9
# CHECK_INTERVAL_MINUTES=15
# GRID_EXPORT_ALERT_THRESHOLD_KW=1.0

# Telegram & AI Agent Configs
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# Model-Agnostic LLM Provider Options (gemini, nvidia, openai, anthropic)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.7-flash
LLM_THINKING_BUDGET=8192

# Provider API Keys (Set whichever provider you want to use)
NVIDIA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional Custom Base URL (e.g. for NVIDIA NIM or Local vLLM/Ollama)
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# ── GitHub PR Automation (For autonomous bug fix & PR creation via agy) ─────
GITHUB_TOKEN=
GIT_AUTHOR_NAME="Smart EV Charger Bot"
GIT_AUTHOR_EMAIL="bot@users.noreply.github.com"
GIT_COMMITTER_NAME="Smart EV Charger Bot"
GIT_COMMITTER_EMAIL="bot@users.noreply.github.com"

